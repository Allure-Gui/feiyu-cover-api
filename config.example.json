{
  "host": "0.0.0.0",
  "port": 19655,
  "api_key": "",
  "data_dir": "~/.local/share/feiyu-cover/jobs",
  "rvc": {
    "python": "/home/YOUR_USER/.local/share/feiyu-voice/cuda/rvc/bin/python",
    "cwd": "/home/YOUR_USER/.local/share/feiyu-voice/cuda/rvc/Applio",
    "model": "/home/YOUR_USER/.local/share/feiyu-voice/astrbot_plugin_feiyu_voice/server/models/FeiyuVoice-RVC/FeiyuVoice-RVC-v1.pth",
    "index": "/home/YOUR_USER/.local/share/feiyu-voice/astrbot_plugin_feiyu_voice/server/models/FeiyuVoice-RVC/FeiyuVoice-RVC-v1.index",
    "pitch": 0,
    "index_rate": 0.3,
    "protect": 0.33,
    "volume_envelope": 0.25,
    "f0_method": "rmvpe",
    "command": "\"{python}\" core.py infer --input-path \"{input}\" --output-path \"{output}\" --pth-path \"{model}\" --index-path \"{index}\" --pitch {pitch} --index-rate {index_rate} --protect {protect} --volume-envelope {volume_envelope} --f0-method {f0_method} --embedder-model contentvec --export-format WAV",
    "timeout": 1800,
    "extra_env": {},
    "models_dir": "/home/YOUR_USER/.local/share/feiyu-voice/cuda/rvc/source/logs"
  },
  "separate": {
    "python": "/home/YOUR_USER/.local/share/feiyu-voice/demucs/bin/python",
    "model": "htdemucs",
    "device": "cuda",
    "timeout": 1800,
    "command": "\"{python}\" -m demucs --two-stems=vocals -n \"{model}\" -d {device} -o \"{outdir}\" \"{input}\""
  },
  "mix": {
    "ffmpeg": "ffmpeg",
    "ffprobe": "ffprobe",
    "vocal_gain_db": -3.0,
    "inst_gain_db": -9.0,
    "out_format": "mp3",
    "bitrate": "320k",
    "loudnorm": true,
    "sample_rate": 44100
  },
  "source": {
    "provider": "txqq",
    "txqq_base": "https://music.txqq.pro/",
    "cookie": "",
    "search_limit": 5,
    "bili_enabled": true,
    "order": [
      "bilibili",
      "gd",
      "txqq",
      "qq"
    ]
  },
  "limits": {
    "max_song_seconds": 420,
    "max_queue": 8
  }
}