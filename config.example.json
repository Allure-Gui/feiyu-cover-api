{
  "host": "0.0.0.0",
  "port": 19655,
  "api_key": "",
  "data_dir": "~/.local/share/feiyu-cover/jobs",
  "rvc": {
    "python": "/home/YOUR_USER/.local/share/feiyu-voice/cuda/rvc/venv/bin/python",
    "cwd": "/home/YOUR_USER/.local/share/feiyu-voice/cuda/rvc/source",
    "model": "/home/YOUR_USER/.local/share/feiyu-voice/cuda/rvc/source/logs/YOUR_MODEL/model.pth",
    "index": "/home/YOUR_USER/.local/share/feiyu-voice/cuda/rvc/source/logs/YOUR_MODEL/model.index",
    "models_dir": "/home/YOUR_USER/.local/share/feiyu-voice/cuda/rvc/source/logs",
    "pitch": 0,
    "index_rate": 0.55,
    "protect": 0.45,
    "volume_envelope": 0.25,
    "f0_method": "rmvpe",
    "formant_shifting": false,
    "formant_qfrency": 1.0,
    "formant_timbre": 1.0,
    "use_worker": true,
    "idle_unload_seconds": 180,
    "cpu_threads": 4,
    "nice": 10,
    "trim_silence": true,
    "auto_pitch": true,
    "auto_pitch_threshold_hz": 165.0,
    "f0_autotune": false,
    "f0_autotune_strength": 0.5,
    "command": "\"{python}\" core.py infer --input-path \"{input}\" --output-path \"{output}\" --pth-path \"{model}\" --index-path \"{index}\" --pitch {pitch} --index-rate {index_rate} --protect {protect} --volume-envelope {volume_envelope} --f0-method {f0_method} --embedder-model {embedder_model} --export-format WAV {formant_flag} --formant-qfrency {formant_qfrency} --formant-timbre {formant_timbre} {autotune_flag}",
    "timeout": 1800,
    "extra_env": {}
  },
  "separate": {
    "python": "/home/YOUR_USER/.local/share/feiyu-voice/demucs/bin/python",
    "model": "vocals_mel_band_roformer.ckpt",
    "model_dir": "/home/YOUR_USER/.local/share/feiyu-voice/separator-models",
    "purify_vocals": true,
    "karaoke_model": "mel_band_roformer_karaoke_aufr33_viperx_sdr_10.1956.ckpt",
    "dereverb_model": "UVR-DeEcho-DeReverb.pth",
    "keep_harmony_db": -4.0,
    "device": "cuda",
    "segment": 7,
    "overlap": 2,
    "batch_size": 2,
    "cpu_threads": 4,
    "nice": 10,
    "timeout": 1800,
    "command": "\"{bin_dir}/audio-separator\" -m \"{model}\" --model_file_dir \"{model_dir}\" --output_dir \"{outdir}\" --output_format WAV --use_soundfile --use_autocast --mdxc_overlap {overlap} --mdxc_batch_size {batch_size} \"{input}\""
  },
  "mix": {
    "ffmpeg": "ffmpeg",
    "ffprobe": "ffprobe",
    "ffmpeg_threads": 4,
    "vocal_gain_db": -3.0,
    "inst_gain_db": -9.0,
    "out_format": "mp3",
    "bitrate": "320k",
    "loudnorm": true,
    "sample_rate": 44100,
    "follow_pitch": true,
    "vocal_eq": true,
    "vocal_presence_db": 2.0,
    "vocal_deess_db": -2.2,
    "vocal_air_db": 0.9,
    "vocal_lowcut_hz": 90,
    "vocal_mud_cut_db": -2.2,
    "vocal_gate_on": true,
    "vocal_compress": true,
    "vocal_reverb": true,
    "vocal_reverb_mix": 0.05,
    "inst_vocal_pocket_db": -2.2,
    "voice_clip": true,
    "voice_clip_seconds": 60,
    "voice_clip_offset_ratio": 0.3,
    "voice_sample_rate": 44100,
    "voice_channels": 2,
    "voice_bitrate": "192k",
    "auto_gain": true,
    "loudness_mode": "lufs",
    "vocal_target_db": -11.5,
    "inst_target_db": -18.5,
    "min_vocal_db": -45.0,
    "min_vocal_active_ratio": 0.3
  },
  "source": {
    "provider": "txqq",
    "txqq_base": "https://music.txqq.pro/",
    "txqq_types": [
      "kugou",
      "netease"
    ],
    "cookie": "",
    "search_limit": 8,
    "bili_enabled": true,
    "bili_fallback": true,
    "meting_enabled": true,
    "order": [
      "bilibili",
      "gd",
      "txqq",
      "qq"
    ],
    "allow_cover_fallback": true,
    "gd_api": "https://music-api.gdstudio.xyz/api.php",
    "gd_sources": [
      "netease"
    ],
    "bili_search_api": "https://api.bilibili.com/x/web-interface/search/type",
    "bili_view_api": "https://api.bilibili.com/x/web-interface/view",
    "bili_play_api": "https://api.bilibili.com/x/player/playurl",
    "bili_cookie": "",
    "qq_cookie": "",
    "qq_cookie_file": ""
  },
  "limits": {
    "max_song_seconds": 420,
    "max_queue": 8
  },
  "cleanup": {
    "enabled": true,
    "max_age_days": 7,
    "max_size_mb": 2048,
    "keep_jobs": 30,
    "check_interval_hours": 24
  }
}
